# ---------------------------------------------------------------------------
# CloudOps Copilot — environment configuration (example)
# Copy to prod.env and fill in real values. prod.env is gitignored.
# ---------------------------------------------------------------------------

# --- Gemini (Google AI Studio) ---
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-ai-studio-api-key-here

# --- Models ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-2.5-flash

# --- Retrieval ---
TOP_K=5
# Cosine-distance ceiling (0=identical, 2=opposite). Results above this are
# treated as "no relevant evidence found" so the model can decline honestly.
MAX_DISTANCE=0.65

# --- Database ---
# When running the backend on the host against the Dockerized DB, use localhost.
# Inside docker-compose the backend reaches the db service by its name ("db").
DATABASE_URL=postgresql://cloudops:cloudops@localhost:5432/cloudops
POSTGRES_USER=cloudops
POSTGRES_PASSWORD=cloudops
POSTGRES_DB=cloudops

# --- App ---
LOG_LEVEL=INFO
